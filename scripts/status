#!/bin/bash
# status
#
# Reports on the game world this copy of neuron is pointed at: which deployment,
# which profile, whether its database and its game server are running, and -- if
# they are -- how many characters exist and how many people are currently
# playing.
#
# This is the tool you run first when something is not working. It names the
# service that is down and the one thing to do about it, rather than leaving you
# to infer that from a failure somewhere else.
#
# Usage:
#   scripts/status              report on the configured deployment
#   scripts/status /path/to/neuron   run against a different neuron checkout

set -euo pipefail

# {{{ set_dir
DIR="/mnt/mtwo/games/azeroth-core/wow-chat-neuron"
if [[ -n "${1:-}" && -d "${1:-}" ]]; then
    DIR="$1"
    shift
fi
# }}}

# {{{ paths
STATUS_LUA="${DIR}/src/010-status-board.lua"
SHARED_MEMORY="${DIR}/tmp/shared-memory"
# }}}

# {{{ ensure_shared_memory
# Both RAM tiers are empty after every reboot, and the symlinks pointing into
# them dangle until they are recreated -- at which point mkdir through the link
# fails saying "File exists", about the link rather than about the directory.
source "${DIR}/scripts/ram-tier"
ensure_ram_tier "${DIR}"
# }}}

# {{{ run
exec luajit "${STATUS_LUA}" "${DIR}"
# }}}
