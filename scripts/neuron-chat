#!/bin/bash
# neuron-chat
#
# Opens a chat window in your browser that talks to the running game world.
# You type what you want; it tells you what it would do; you say yes or no.
#
# The server it starts listens only on this machine's own loopback address, so
# nothing on the network can reach it. That is deliberate and not a placeholder:
# this thing can empty a world and it asks nobody who they are.
#
# Usage:
#   scripts/neuron-chat            open on the default port
#   scripts/neuron-chat --port N        open on a different port
#   scripts/neuron-chat --profile NAME  point this window at a different world

set -euo pipefail

# {{{ set_dir
DIR="/mnt/mtwo/games/azeroth-core/wow-chat-neuron"
if [[ -n "${1:-}" && -d "${1:-}" && -f "${1:-}/src/022-http-server.lua" ]]; then
    DIR="$1"
    shift
fi
# }}}

# {{{ settings
PORT="7879"
PROFILE=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --port)    PORT="$2";    shift 2 ;;
        --profile) PROFILE="$2"; shift 2 ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
done
# }}}

# {{{ ensure_shared_memory
# The shared-memory tier is RAM and is empty after a reboot, so anything writing
# a receipt has to be prepared to find it missing.
mkdir -p "${DIR}/tmp/shared-memory/receipts"
# }}}

# {{{ run
exec luajit "${DIR}/src/023-chat-main.lua" "${DIR}" "${PORT}" "${PROFILE}"
# }}}
