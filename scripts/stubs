#!/bin/bash
# stubs
#
# List every placeholder in the project: a path that works and is not the thing
# it will eventually be.
#
# Generated by loading the source and asking, rather than by searching for
# comments -- so the list cannot disagree with the code, and a stub that was
# quietly finished stops appearing here the moment its declaration is removed.
#
# Usage:
#   scripts/stubs                run against this project
#   scripts/stubs /other/project run against another checkout

set -euo pipefail

# {{{ set_dir
DIR="/mnt/mtwo/games/azeroth-core/wow-chat-neuron"
if [[ -n "${1:-}" && -d "${1:-}" && -d "${1:-}/src" ]]; then
    DIR="$1"
fi
# }}}

# {{{ run
exec luajit "${DIR}/src/055-list-stubs.lua" "${DIR}"
# }}}
