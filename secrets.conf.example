# neuron secrets
#
# Copy to secrets.conf and fill in. secrets.conf is gitignored.
#
# Only ONE secret belongs here: the password for the GM game account that
# neuron authenticates as when it sends commands to a running worldserver.
#
# The DATABASE password is deliberately NOT here. It belongs to the deployment,
# and neuron reads it out of the deployment's own secrets.conf. Copying it into
# a second file would mean two places to rotate it and one place to forget.

# The password for the account named in config/deployment.lua as soap_account.
# That account must hold GM rank, or the worldserver accepts the connection and
# rejects every command with a permissions error.
NEURON_SOAP_PASSWORD=your_gm_account_password
